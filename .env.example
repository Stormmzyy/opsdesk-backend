# Every environment variable the backend reads. Copy it to .env and replace
# every value: these are fakes, and .env (ignored by Git) is where real ones
# go. Never put a real value in this file.
#
# Who reads .env: Docker Compose, from the folder it runs in. Spring itself
# does NOT read it. For a run outside Docker, export the values first:
#   bash:        set -a; . ./.env; set +a; ./mvnw spring-boot:run
#   PowerShell:  Get-Content .env | Where-Object { $_ -match '^[A-Z_]+=' } |
#                  ForEach-Object { $n, $v = $_ -split '=', 2; Set-Item "env:$n" $v }
#
# On a development machine you need none of this:
# SPRING_PROFILES_ACTIVE=dev supplies a value for everything below except the
# profile itself (application-dev.yml).
#
# The required ones are exactly the settings with an empty default in
# src/main/resources/application.yml; EnvExampleTest fails if this file and
# that list ever disagree.

# Which profile to run. Unset means production rules (NOTES.md, decision 68):
# every variable below must then be set, or the app refuses to start and names
# the missing one. "dev" switches on application-dev.yml's local defaults and
# the sample data; never use it on a server.
SPRING_PROFILES_ACTIVE=prod

# The database. In Docker the host is the service name (db) and the port is
# PostgreSQL's own; from this machine it's localhost and the published port.
DB_URL=jdbc:postgresql://db:5432/opsdesk
DB_USER=opsdesk
DB_PASSWORD=replace-me-with-the-database-password

# Signs every login token: anyone who has it can sign in as anyone. At least
# 32 bytes, random, and only here. Generate one with:
#   openssl rand -base64 48
# This placeholder is deliberately too short, so a copy of this file that was
# never edited refuses to start instead of running with a published key.
JWT_SECRET=CHANGE-ME

# The one origin (scheme://host:port, no path, no trailing slash) whose pages
# may call the API from a browser: where the frontend is served from.
ALLOWED_ORIGIN=http://localhost:3000
