<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.opsdesk</groupId>
	<artifactId>opsdesk-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>opsdesk-backend</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Not managed by Spring Boot, so the version is set here. Latest 0.12.x, as the Week 7 guide asks. -->
		<jjwt.version>0.12.7</jjwt.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<!-- Boot 3: spring-boot-starter-web -->
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Same name in Boot 3. As soon as it's on the classpath, every endpoint needs a login. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- JWT: the API is all the code compiles against; the implementation and its
		     Jackson-based JSON support are only needed at runtime, as the jjwt README says. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<!-- jjwt-jackson uses Jackson 2 (com.fasterxml.jackson). Boot 4's own JSON is Jackson 3
		     (tools.jackson); in Boot 3 both were Jackson 2. The two sit side by side without conflict. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Boot 3: these three per-feature test starters were all one dependency, spring-boot-starter-test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- For Friday's tests. Boot 3: org.springframework.security:spring-security-test,
		     added directly. In Boot 4 this per-feature starter brings it in. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- An in-memory database for Friday's tests (application-test.yml), so they
		     don't need PostgreSQL running. Version managed by Boot, same as Boot 3. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				Refuses to build on a JDK older than java.version, before anything is compiled.

				Why it exists: with JAVA_HOME on JDK 17, a target/ left by an IDE that compiled with
				JDK 21 looks up to date, so Maven skips compiling and never notices the mismatch. The
				failure comes later, when the test JVM refuses to load the classes ("class file version
				65.0 ... only recognizes up to 61.0"), which points at the tests, not at JAVA_HOME. This
				turns that into one line at the start naming the JDK needed and the JDK running.

				CI cannot catch this: it clones fresh, so target/ is empty, and a wrong JDK there fails
				loudly at compile time. It only happens on a developer machine, so the build has to
				check for itself.

				Version managed by the Spring Boot parent. Same in Boot 3.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>require-java</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<!-- [21,) is "21 or later", as the README says; the number comes from java.version above, so it lives in one place. -->
									<version>[${java.version},)</version>
									<!--
										The message replaces the plugin's own, so it must name the running JDK itself.
										${java.version} here is the project's 21: the property above hides the JVM
										property of the same name. java.runtime.version and java.home aren't defined
										by the project, so they still come from the JVM that's running Maven.
									-->
									<message>OpsDesk needs JDK ${java.version} or later, but this build is running on JDK ${java.runtime.version} (${java.home}). Point JAVA_HOME at a JDK ${java.version} or later and run it again.</message>
								</requireJavaVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
